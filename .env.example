# 2С ERP — Базові змінні середовища для розгортання клієнту
# Скопіюйте цей файл у .env перед запуском у production

# Порт API-сервера
PORT=4000

# Підключення до PostgreSQL (рекомендовано для production).
# Якщо залишити порожнім — система автоматично працює на вбудованій PGlite БД.
DATABASE_URL=

# Папка локальної БД PGlite (використовується, якщо DATABASE_URL порожній)
PGLITE_DATA_DIR=./data/pglite

# Стартовий логін і пароль адміністратора при першому запуску на чистій базі
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-this-password
