# 2С ERP — Базові змінні середовища для розгортання клієнту
# Скопіюйте цей файл у .env перед запуском у production

# === Docker Compose (PostgreSQL + API + Web) ===
POSTGRES_DB=erp2c
POSTGRES_USER=erp2c
POSTGRES_PASSWORD=ChangeMeStrongDbPass2026
APP_BIND_IP=127.0.0.1
APP_PORT=8088

# === Стартовий логін і пароль адміністратора при першому запуску на чистій базі ===
ADMIN_LOGIN=admin
ADMIN_PASSWORD=ChangeMeStrongAdminPass2026

# === Локальний запуск без Docker ===
HOST=127.0.0.1
PORT=4000
# Якщо DATABASE_URL порожній — система працює на вбудованій PGlite БД
DATABASE_URL=
PGLITE_DATA_DIR=./data/pglite
